# Cairn frontend — local dev env (BLUEPRINT.md §4, §5).
#
# Copy to `.env` for standalone `pnpm dev` (outside docker-compose, where the
# root `.env`'s VITE_API_BASE_URL doesn't reach Vite directly). Same variable,
# same default — see the root `.env.example`'s Frontend section.
VITE_API_BASE_URL=http://localhost:8000
