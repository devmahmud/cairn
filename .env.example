# =============================================================================
# Cairn — environment configuration (BLUEPRINT.md §3.2, §5)
#
# Copy to `.env` before running `make setup` / `make up`. Every default below
# is offline-first and safe for local dev — nothing here requires an external
# credential to boot (USE_LOCAL_RETRIEVAL, guardrails, and Langfuse all default
# off/local). Tighten these before ENVIRONMENT=staging|prod.
# =============================================================================

# --- Core --------------------------------------------------------------------
ENVIRONMENT=local                         # local | staging | prod — gates the JWT_SECRET fail-fast check
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app   # Postgres 16 + pgvector (rows + vectors + FTS)
CONFIG_DIR=config                         # backend/config — prompts/*.j2 + behavior/*.yaml, watchfiles-reloaded
CORS_ALLOW_ORIGINS=http://localhost:5173  # explicit comma-separated allowlist — never `*` with credentials
MCP_ENABLED=false                         # in-process FastMCP demo server + client (Appendix A) — off by default
SESSION_SWEEPER_ENABLED=false             # background conversation-summary sweeper (advisory-lock leader election)

# --- LLM -----------------------------------------------------------------------
OPENAI_API_KEY=                           # blank is fine when OPENAI_BASE_URL points at a local model/proxy
OPENAI_BASE_URL=                          # point at LiteLLM / Ollama / vLLM; blank = OpenAI's own API
OPENAI_MODEL=gpt-4o-mini                  # default chat-completion model
STRUCTURED_OUTPUT_MODE=json_schema        # json_schema | json_mode | guided_json — provider-dependent forced output
LITELLM_MASTER_KEY=                       # only read when OPENAI_BASE_URL points at the local LiteLLM proxy (`make up-litellm`)

# --- Retrieval -----------------------------------------------------------
USE_LOCAL_RETRIEVAL=true                  # true = zero-dep fixture retrieval; false = real pgvector hybrid+rerank
EMBEDDING_MODEL=Qwen3-Embedding-0.6B      # self-hosted (Apache-2.0) via OPENAI_BASE_URL; opt-in hosted: text-embedding-3-small
EMBEDDING_DIMENSION=1024                  # must match the `chunks.embedding vector()` column width
RERANK_ENABLED=true                       # cross-encoder rerank (bge-reranker-v2-m3) after RRF fusion

# --- Streaming -----------------------------------------------------------------
REDIS_URL=                                # blank = simple in-request SSE, no cache; set to enable durable streams + limits
STREAM_DURABLE=false                      # true = Redis-backed resumable streams (requires REDIS_URL)

# --- Guardrails ------------------------------------------------------------
GUARDRAILS_ENABLED=false                  # true = input/output rails + PII redaction (Presidio + NeMo Guardrails + Granite Guardian)

# --- Limits ------------------------------------------------------------------
RATE_LIMIT_PER_MIN=0                      # 0 = off; per-user/IP slowapi limit on /chat
MAX_GRAPH_HOPS=6                          # hard cap on tool-node loop iterations per turn
TURN_BUDGET_SECONDS=90.0                  # wall-clock budget wrapping the whole graph run

# --- Auth ----------------------------------------------------------------
AUTH_ENABLED=true                         # fastapi-users + ownership checks; conversations are per-user by default (§3.9)
JWT_SECRET=change-me                      # MUST be overridden when ENVIRONMENT != local (fail-fast enforced)

# --- Observability -------------------------------------------------------------
LANGFUSE_ENABLED=false                    # true = trace calls + cost to self-hosted Langfuse
LANGFUSE_PROMPTS=false                    # true = fetch prompts by label from Langfuse, fallback to config/prompts/*.j2
LANGFUSE_PUBLIC_KEY=                      # from your self-hosted Langfuse project settings
LANGFUSE_SECRET_KEY=                      # from your self-hosted Langfuse project settings
LANGFUSE_HOST=http://localhost:3000       # self-hosted Langfuse URL (docker-compose.langfuse.yml)

# --- Frontend ------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000   # backend origin the SPA talks to (REST + SSE)
