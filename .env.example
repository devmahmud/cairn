# =============================================================================
# Cairn — environment configuration (BLUEPRINT.md §3.2, §5)
#
# Copy to `.env` before running `make setup` / `make up`. Every default below
# is offline-first and safe for local dev — nothing here requires an external
# credential to boot (USE_LOCAL_RETRIEVAL, guardrails, and Langfuse all default
# off/local). Tighten these before ENVIRONMENT=staging|prod.
#
# NOTE: values here never carry a trailing "# comment" on the same line as a
# blank/empty value — Docker Compose's `env_file:` loader (unlike a shell
# `source`) does NOT strip inline comments, so `KEY=  # comment` would set KEY
# to the literal string "# comment". Every comment lives on its own line above
# the variable it documents instead.
# =============================================================================

# --- Core --------------------------------------------------------------------
# local | staging | prod — gates the JWT_SECRET fail-fast check
ENVIRONMENT=local
# Postgres 16 + pgvector (rows + vectors + FTS)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# backend/config — prompts/*.j2 + behavior/*.yaml, watchfiles-reloaded
CONFIG_DIR=config
# explicit comma-separated allowlist — never `*` with credentials
CORS_ALLOW_ORIGINS=http://localhost:5173
# in-process FastMCP demo server + client (Appendix A) — off by default
MCP_ENABLED=false
# background conversation-summary sweeper (advisory-lock leader election)
SESSION_SWEEPER_ENABLED=false

# --- LLM -----------------------------------------------------------------------
# blank is fine when OPENAI_BASE_URL points at a local model/proxy
OPENAI_API_KEY=
# point at LiteLLM / Ollama / vLLM; blank = OpenAI's own API
OPENAI_BASE_URL=
# default chat-completion model
OPENAI_MODEL=gpt-4o-mini
# json_schema | json_mode | guided_json — provider-dependent forced output
STRUCTURED_OUTPUT_MODE=json_schema
# only read when OPENAI_BASE_URL points at the local LiteLLM proxy (`make up-litellm`)
LITELLM_MASTER_KEY=

# --- Retrieval -----------------------------------------------------------
# true = zero-dep fixture retrieval; false = real pgvector hybrid+rerank
USE_LOCAL_RETRIEVAL=true
# self-hosted (Apache-2.0) via OPENAI_BASE_URL; opt-in hosted: text-embedding-3-small
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
# must match the `chunks.embedding vector()` column width
EMBEDDING_DIMENSION=1024
# cross-encoder rerank (bge-reranker-v2-m3) after RRF fusion
RERANK_ENABLED=true
# self-hosted reranker endpoint (TEI/vLLM); blank = rerank degrades to a no-op passthrough
RERANKER_BASE_URL=
# self-hosted (Apache-2.0); Qwen3-Reranker is the higher-accuracy alternative
RERANKER_MODEL=bge-reranker-v2-m3

# --- Streaming -----------------------------------------------------------------
# blank = simple in-request SSE, no cache; set to enable durable streams + limits
REDIS_URL=
# true = Redis-backed resumable streams (requires REDIS_URL)
STREAM_DURABLE=false

# --- Guardrails ------------------------------------------------------------
# true = input/output rails + PII redaction (Presidio + Granite Guardian, §3.12)
GUARDRAILS_ENABLED=false
# self-hosted Granite Guardian endpoint (vLLM/Ollama, OpenAI-compatible); blank = skip the guard-model layer, denylist+PII still run
GUARDIAN_MODEL_BASE_URL=
GUARDIAN_MODEL_NAME=granite-guardian-3.3-8b
GUARDIAN_MODEL_RISK_NAME=jailbreak
GUARDIAN_MODEL_TIMEOUT_SECONDS=10.0
# Llama Guard is OPT-IN ONLY -- its license is not OSI-approved open source
# (700M-MAU commercial cap + binding AUP + mandatory attribution, §3.12).
# Not reachable via GUARDRAILS_ENABLED alone; see core/guardrails/llama_guard.py.
GUARDRAILS_LLAMA_GUARD_OPT_IN=false
LLAMA_GUARD_MODEL_BASE_URL=
LLAMA_GUARD_MODEL_NAME=llama-guard-3-8b

# --- Limits ------------------------------------------------------------------
# 0 = off; per-user/IP slowapi limit on /chat
RATE_LIMIT_PER_MIN=0
# asyncio.Semaphore cap on in-flight generations
MAX_CONCURRENT_GENERATIONS=10
# hard cap on tool-node loop iterations per turn
MAX_GRAPH_HOPS=6
# wall-clock budget wrapping the whole graph run
TURN_BUDGET_SECONDS=90.0

# --- Auth ----------------------------------------------------------------
# fastapi-users + ownership checks; conversations are per-user by default
# (§3.9). false = fixed anonymous identity (eval/CI only)
AUTH_ENABLED=true
# MUST be overridden when ENVIRONMENT != local (fail-fast enforced)
JWT_SECRET=change-me
# short-lived JWT access token (stateless-verified, no DB round trip)
ACCESS_TOKEN_LIFETIME_SECONDS=3600
# 30 days; DB-backed, revocable via POST /auth/logout
REFRESH_TOKEN_LIFETIME_SECONDS=2592000

# --- Observability -------------------------------------------------------------
# true = trace calls + cost to self-hosted Langfuse
LANGFUSE_ENABLED=false
# true = fetch prompts by label from Langfuse, fallback to config/prompts/*.j2
LANGFUSE_PROMPTS=false
# from your self-hosted Langfuse project settings
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# self-hosted Langfuse URL (docker-compose.langfuse.yml)
LANGFUSE_HOST=http://localhost:3000
# label to fetch (production | prod-a | prod-b, ...) — enables hot iteration/A-B/rollback
LANGFUSE_PROMPT_LABEL=production

# --- Frontend ------------------------------------------------------------------
# backend origin the SPA talks to (REST + SSE)
VITE_API_BASE_URL=http://localhost:8000
